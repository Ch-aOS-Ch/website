---

<div class="code-window-card backdrop-blur-md rounded-none shadow-2xl overflow-hidden">
  <div class="code-window-header flex items-center justify-between gap-2 px-2.5 sm:px-5 py-2 sm:py-3 border-b border-[#3D524A]/40">
    <div class="flex items-center gap-2 min-w-0 flex-1 overflow-x-auto no-scrollbar py-0.5">
      <div class="flex items-center gap-1 sm:gap-1.5 bg-[#121916]/60 p-0.5 sm:p-1 rounded-none border border-[#3D524A]/60 text-xs sm:text-[13px] font-mono shrink-0" id="code-tabs" role="tablist" aria-label="Code examples">
        <button 
          type="button" 
          role="tab"
          id="tab-btn-chobolo"
          aria-selected="true"
          aria-controls="tab-chobolo"
          tabindex="0"
          data-target="tab-chobolo" 
          class="tab-btn px-2.5 sm:px-3 py-1.5 min-h-[44px] sm:min-h-0 flex items-center justify-center rounded-none font-medium transition-colors cursor-pointer text-[11px] sm:text-[13px] shrink-0 whitespace-nowrap"
        >
          ch-obolo.yml
        </button>
        <button
          type="button" 
          role="tab"
          id="tab-btn-role"
          aria-selected="false"
          aria-controls="tab-role"
          tabindex="-1"
          data-target="tab-role" 
          class="tab-btn px-2.5 sm:px-3 py-1.5 min-h-[44px] sm:min-h-0 flex items-center justify-center rounded-none font-medium transition-colors cursor-pointer text-[11px] sm:text-[13px] shrink-0 whitespace-nowrap"
        >
          role.py
        </button>
        <button 
          type="button" 
          role="tab"
          id="tab-btn-cli"
          aria-selected="false"
          aria-controls="tab-cli"
          tabindex="-1"
          data-target="tab-cli" 
          class="tab-btn px-2.5 sm:px-3 py-1.5 min-h-[44px] sm:min-h-0 flex items-center justify-center rounded-none font-medium transition-colors cursor-pointer text-[11px] sm:text-[13px] shrink-0 whitespace-nowrap"
        >
          run command
        </button>
      </div>
    </div>

    <div class="flex items-center gap-2 shrink-0">
      <button
        type="button"
        class="copy-code-btn flex items-center justify-center gap-1.5 px-3 py-2 sm:px-2.5 sm:py-1 min-h-[44px] sm:min-h-0 text-xs font-mono cursor-pointer rounded-none relative z-10"
        title="Copy active code"
        aria-label="Copy active code"
        aria-live="polite"
      >
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="9" y="9" width="13" height="13"></rect>
          <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
        </svg>
        <span class="copy-label">Copy</span>
      </button>
    </div>
  </div>

  <div class="p-3 sm:p-6 font-mono text-xs sm:text-sm md:text-base leading-relaxed overflow-x-auto overflow-y-auto h-[340px] sm:h-[490px] text-[#E8F0EC] [data-theme=light]:text-[#14241E]">
    <div id="tab-chobolo" role="tabpanel" aria-labelledby="tab-btn-chobolo" tabindex="0" class="tab-pane block focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-[#38D9A9]">
      <Code code={choboloCode} lang="yaml" themes={chaosThemes} class="bg-transparent! m-0! p-0!" />
    </div>

    <div id="tab-role" role="tabpanel" aria-labelledby="tab-btn-role" tabindex="0" class="tab-pane hidden focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-[#38D9A9]">
      <Code code={roleCode} lang="python" themes={chaosThemes} class="bg-transparent! m-0! p-0!" />
    </div>

    <div id="tab-cli" role="tabpanel" aria-labelledby="tab-btn-cli" tabindex="0" class="tab-pane hidden focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-[#38D9A9]">
      <Code code={cliCode} lang="bash" themes={chaosThemes} class="bg-transparent! m-0! p-0!" />
    </div>
  </div>
</div>

<style>
  .code-window-card pre,
  .code-window-card code {
    white-space: pre-wrap !important;
    word-break: break-word !important;
    overflow-wrap: anywhere !important;
  }
  .tab-btn[aria-selected="true"] {
    color: #E8F0EC;
    background-color: #25342E;
    border: 1px solid rgba(248, 165, 194, 0.6);
  }
  .tab-btn[aria-selected="false"] {
    color: #8E9EA0;
    border: 1px solid transparent;
  }
  .tab-btn[aria-selected="false"]:hover {
    color: #F8A5C2;
  }
  :global(html[data-theme="light"]) .tab-btn[aria-selected="true"] {
    color: #C92861 !important;
    background-color: rgba(255, 255, 255, 0.95) !important;
    border: 1px solid #C92861 !important;
    font-weight: 600 !important;
    box-shadow: 0 1px 3px rgba(201, 40, 97, 0.12);
  }
  :global(html[data-theme="light"]) .tab-btn[aria-selected="false"] {
    color: #486156 !important;
  }
  :global(html[data-theme="light"]) .tab-btn[aria-selected="false"]:hover {
    color: #C92861 !important;
  }
  :global(html[data-theme="light"]) .code-encoding {
    color: #486156 !important;
  }
  :global(html[data-theme="light"]) .copy-code-btn {
    background-color: rgba(225, 240, 232, 0.95) !important;
    border-color: #A9BCB3 !important;
    color: #14241E !important;
  }
  :global(html[data-theme="light"]) .copy-code-btn:hover {
    background-color: #D4DFDA !important;
    border-color: #137A5B !important;
    color: #137A5B !important;
  }
</style>

<script>
  function setupHeroTabs() {
    const tabButtons = document.querySelectorAll<HTMLButtonElement>('#code-tabs .tab-btn');
    const tabPanes = document.querySelectorAll<HTMLElement>('.tab-pane');
    const tabsContainer = document.getElementById('code-tabs');

    function activateTab(targetBtn: HTMLButtonElement) {
      const targetId = targetBtn.getAttribute('data-target');

      tabButtons.forEach(btn => {
        const isSelected = btn === targetBtn;
        btn.setAttribute('aria-selected', isSelected ? 'true' : 'false');
        btn.setAttribute('tabindex', isSelected ? '0' : '-1');
      });

      tabPanes.forEach(pane => {
        if (pane.id === targetId) {
          pane.classList.remove('hidden');
          pane.classList.add('block');
        } else {
          pane.classList.remove('block');
          pane.classList.add('hidden');
        }
      });
    }

    tabButtons.forEach(button => {
      button.addEventListener('click', () => {
        activateTab(button);
      });
    });

    if (tabsContainer && !tabsContainer.dataset.keyboardBound) {
      tabsContainer.dataset.keyboardBound = 'true';
      tabsContainer.addEventListener('keydown', (e: KeyboardEvent) => {
        const tabs = Array.from(tabButtons);
        const currentIndex = tabs.findIndex(tab => tab === document.activeElement);
        if (currentIndex === -1) return;

        let nextIndex = -1;
        if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
          e.preventDefault();
          nextIndex = (currentIndex + 1) % tabs.length;
        } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
          e.preventDefault();
          nextIndex = (currentIndex - 1 + tabs.length) % tabs.length;
        } else if (e.key === 'Home') {
          e.preventDefault();
          nextIndex = 0;
        } else if (e.key === 'End') {
          e.preventDefault();
          nextIndex = tabs.length - 1;
        }

        if (nextIndex !== -1) {
          tabs[nextIndex].focus();
          activateTab(tabs[nextIndex]);
        }
      });
    }

    const copyBtn = document.querySelector<HTMLButtonElement>('.code-window-card .copy-code-btn');
    if (copyBtn && !copyBtn.dataset.listenerAttached) {
      copyBtn.dataset.listenerAttached = 'true';
      copyBtn.addEventListener('click', () => {
        const activePane = document.querySelector('.code-window-card .tab-pane.block');
        const codeElement = activePane ? activePane.querySelector('code') || activePane : null;
        if (codeElement) {
          const text = codeElement.innerText || codeElement.textContent || '';
          navigator.clipboard.writeText(text.trim());
          const label = copyBtn.querySelector('.copy-label');
          if (label) {
            const originalText = label.textContent;
            label.textContent = 'Copied!';
            setTimeout(() => {
              label.textContent = originalText;
            }, 1500);
          }
        }
      });
    }
  }

  setupHeroTabs();
  document.addEventListener('astro:page-load', setupHeroTabs);
</script>
