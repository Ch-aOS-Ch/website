---
// CodeCarousel.astro
// Code showcase with official Ch-aOS palette (#121916, #38D9A9, #3D524A, #C1C9D6, #E8F0EC)
import { Code } from 'astro:components';
import { chaosThemes } from '../themes/index.mjs';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const choboloCode = `# ch-obolo.yml

# IaC
pelago:
  - name: "prod-vpc"
    type: "aws:ec2:Vpc"
    properties:
      cidrBlock: "10.0.0.0/16"
      enableDnsHostnames: true

  - name: "web-server"
    isle: "aws-ec2"
    depends_on: ["prod-vpc"]
    config:
      instance_type: "t3.medium"
      ami: "ami-0c55b159cbfafe1f0"
      key_name: "deployer-key"
    exports:
      hosts:
        web-server:
          ssh_hostname: "\${web-server.publicIp}"
          ssh_user: "ubuntu"

# Multi-fleet system
fleet:
  parallelism: 5
  hosts:
    web-01:
      ssh_hostname: "192.168.1.50"
      ssh_user: "deployer"
      ssh_port: 22
      ssh_key: "~/.ssh/id_ed25519"
      tags: ["web", "prod"]

# Declarative system configuration
system_packages:
  - "neovim"
  - "ripgrep"
  - "tailscale"
  - "docker.io"

users:
  - name: "deployer"
    shell: "/bin/bash"
    sudo: true
    groups: ["wheel", "docker"]`;

const roleCode = ` # Logic in Python
from chaos.lib.roles.role import Role
from chaos.lib.args.dataclasses import Delta, ResultPayload
from pyinfra.operations import server

class SystemPackagesRole(Role):
    """Canonical 3-stage SDK lifecycle: get_context -> delta -> plan"""
    def __init__(self):
        super().__init__(
            name="system_packages",
            necessary_chobolo_keys=["system_packages"]
        )

    def get_context(self, state, host, chobolo: dict = {}, secrets: dict = {}):
        return {"installed_packages": host.get_fact(server.Packages)}

    def delta(self, context: dict = {}) -> Delta:
        target = set(self.chobolo.get("system_packages", []))
        installed = set(context.get("installed_packages", {}).keys())
        return Delta(to_add={"packages": list(target - installed)})

    def plan(self, state, host, delta: Delta) -> ResultPayload:
        pkgs = delta.to_add.get("packages", [])
        server.packages(
            name=f"Install declared packages",
            packages=pkgs,
            present=True,
            _sudo=True
        )
        return ResultPayload(success=True, message=["Packages planned successfully"])`;

