<script>
  function setupComparisonCarousel() {
    const slides = document.querySelectorAll<HTMLElement>('.comp-slide');
    const prevBtn = document.getElementById('comp-prev-btn');
    const nextBtn = document.getElementById('comp-next-btn');
    const counter = document.getElementById('comp-counter');
    const categoryIndicator = document.getElementById('comp-category-indicator');
    const badgeIndicator = document.getElementById('comp-badge-indicator');

    if (!slides.length) return;

    let currentIndex = 0;
    const total = slides.length;

    function goToSlide(targetIndex: number) {
      if (targetIndex < 0) targetIndex = total - 1;
      if (targetIndex >= total) targetIndex = 0;
      currentIndex = targetIndex;

      slides.forEach((slide, idx) => {
        if (idx === currentIndex) {
          slide.classList.remove('hidden');
          slide.classList.add('block');

          // Update header indicators dynamically from data attributes
          const cat = slide.getAttribute('data-category');
          const badge = slide.getAttribute('data-badge');
          if (categoryIndicator && cat) categoryIndicator.textContent = cat;
          if (badgeIndicator && badge) badgeIndicator.textContent = badge;
        } else {
          slide.classList.remove('block');
          slide.classList.add('hidden');
        }
      });

      if (counter) {
        const curStr = (currentIndex + 1).toString().padStart(2, '0');
        const totalStr = total.toString().padStart(2, '0');
        counter.textContent = `${curStr} / ${totalStr}`;
      }

      // Update mobile bottom counters
      document.querySelectorAll<HTMLElement>('.comp-mobile-counter').forEach((el) => {
        const curStr = (currentIndex + 1).toString().padStart(2, '0');
        const totalStr = total.toString().padStart(2, '0');
        el.textContent = `${curStr} / ${totalStr}`;
      });

      // Update quick navigation tabs (scroll container only, never jerk page window)
      const quickTabs = document.querySelectorAll<HTMLButtonElement>('.comp-quick-tab');
      const tabsContainer = document.querySelector<HTMLElement>('.comp-tool-tabs-container');
      quickTabs.forEach((tab, idx) => {
        const isActive = idx === currentIndex;
        tab.setAttribute('aria-selected', isActive ? 'true' : 'false');
        tab.tabIndex = isActive ? 0 : -1;
        if (isActive) {
          tab.classList.add('comp-quick-tab-active');
          if (tabsContainer) {
            const targetLeft = tab.offsetLeft - (tabsContainer.clientWidth / 2) + (tab.clientWidth / 2);
            tabsContainer.scrollTo({ left: targetLeft, behavior: 'smooth' });
          }
        } else {
          tab.classList.remove('comp-quick-tab-active');
        }
      });

      // Update progress bar
      const progressBar = document.getElementById('comp-progress-bar');
      if (progressBar) {
        const percentage = ((currentIndex + 1) / total) * 100;
        progressBar.style.width = `${percentage}%`;
      }
    }

    // Bind Quick Navigation Tabs
    const quickTabs = document.querySelectorAll<HTMLButtonElement>('.comp-quick-tab');
    quickTabs.forEach((tab) => {
      if (!tab.dataset.bound) {
        tab.dataset.bound = 'true';
        tab.addEventListener('click', () => {
          const target = Number(tab.getAttribute('data-target-index'));
          if (!isNaN(target)) {
            goToSlide(target);
          }
        });
        tab.addEventListener('keydown', (e: KeyboardEvent) => {
          let newTarget = -1;
          if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
            e.preventDefault();
            newTarget = (currentIndex + 1) % total;
          } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
            e.preventDefault();
            newTarget = (currentIndex - 1 + total) % total;
          } else if (e.key === 'Home') {
            e.preventDefault();
            newTarget = 0;
          } else if (e.key === 'End') {
            e.preventDefault();
            newTarget = total - 1;
          }
          if (newTarget !== -1) {
            goToSlide(newTarget);
            quickTabs[newTarget]?.focus();
          }
        });
      }
    });

    if (prevBtn && !prevBtn.dataset.bound) {
      prevBtn.dataset.bound = 'true';
      prevBtn.addEventListener('click', () => {
        goToSlide(currentIndex - 1);
      });
    }

    if (nextBtn && !nextBtn.dataset.bound) {
      nextBtn.dataset.bound = 'true';
      nextBtn.addEventListener('click', () => {
        goToSlide(currentIndex + 1);
      });
    }

    // Bind Mobile Bottom Navigation Buttons
    document.querySelectorAll<HTMLButtonElement>('.comp-mobile-prev-btn').forEach((btn) => {
      if (!btn.dataset.bound) {
        btn.dataset.bound = 'true';
        btn.addEventListener('click', () => {
          goToSlide(currentIndex - 1);
        });
      }
    });

    document.querySelectorAll<HTMLButtonElement>('.comp-mobile-next-btn').forEach((btn) => {
      if (!btn.dataset.bound) {
        btn.dataset.bound = 'true';
        btn.addEventListener('click', () => {
          goToSlide(currentIndex + 1);
        });
      }
    });

    // Touch Swipe Navigation for mobile devices
    const slidesContainer = document.getElementById('comparison-slides');
    if (slidesContainer && !slidesContainer.dataset.touchBound) {
      slidesContainer.dataset.touchBound = 'true';
      let touchStartX = 0;
      let touchStartY = 0;
      let ignoreSwipe = false;

      slidesContainer.addEventListener('touchstart', (e: TouchEvent) => {
        const target = e.target as Element | null;
        if (target && target.closest('.comp-tool-tabs-container, button')) {
          ignoreSwipe = true;
          return;
        }
        ignoreSwipe = false;
        touchStartX = e.changedTouches[0].clientX;
        touchStartY = e.changedTouches[0].clientY;
      }, { passive: true });

      slidesContainer.addEventListener('touchend', (e: TouchEvent) => {
        if (ignoreSwipe) return;
        const target = e.target as Element | null;
        if (target && target.closest('.comp-tool-tabs-container, button')) return;
        const touchEndX = e.changedTouches[0].clientX;
        const touchEndY = e.changedTouches[0].clientY;
        const deltaX = touchEndX - touchStartX;
        const deltaY = touchEndY - touchStartY;

        // Verify gesture has clear horizontal intent and exceeds 40px threshold
        if (Math.abs(deltaX) > Math.abs(deltaY) && Math.abs(deltaX) > 40) {
          if (deltaX > 40) {
            goToSlide(currentIndex - 1);
          } else if (deltaX < -40) {
            goToSlide(currentIndex + 1);
          }
        }
      }, { passive: true });

      slidesContainer.addEventListener('touchcancel', () => {
        ignoreSwipe = false;
        touchStartX = 0;
        touchStartY = 0;
      }, { passive: true });
    }

    // Keyboard Arrow Navigation when interacting with carousel
    const carouselRegion = document.querySelector<HTMLElement>('[role="region"][aria-label="Comparison Carousel"]');
    if (carouselRegion && !carouselRegion.dataset.keyboardBound) {
      carouselRegion.dataset.keyboardBound = 'true';
      carouselRegion.addEventListener('keydown', (e: KeyboardEvent) => {
        if (e.key === 'ArrowLeft') {
          e.preventDefault();
          goToSlide(currentIndex - 1);
        } else if (e.key === 'ArrowRight') {
          e.preventDefault();
          goToSlide(currentIndex + 1);
        }
      });
    }

    // Setup Segmented Declaration <-> Code Toggle Pills
    slides.forEach(slide => {
      const toggleGroup = slide.querySelector<HTMLElement>('.chaos-view-toggle-group');
      const pills = slide.querySelectorAll<HTMLButtonElement>('.chaos-toggle-pill');
      const codeView = slide.querySelector<HTMLElement>('.chaos-code-view, .chaos-view-code');
      const declView = slide.querySelector<HTMLElement>('.chaos-decl-view, .chaos-view-decl');
      const filename = slide.querySelector<HTMLElement>('.chaos-active-filename, .chaos-view-filename');

      const codeFile = slide.getAttribute('data-code-filename') || '';
      const declFile = slide.getAttribute('data-decl-filename') || '';

      if (toggleGroup && pills.length && codeView && declView && !toggleGroup.dataset.bound) {
        toggleGroup.dataset.bound = 'true';

        const setViewMode = (mode: 'decl' | 'code') => {
          const showDecl = mode === 'decl';
          declView.classList.toggle('hidden', !showDecl);
          codeView.classList.toggle('hidden', showDecl);
          if (filename) {
            filename.textContent = showDecl ? declFile : codeFile;
          }
          pills.forEach(pill => {
            const isActive = pill.getAttribute('data-view-mode') === mode;
            pill.setAttribute('aria-pressed', isActive ? 'true' : 'false');
            pill.classList.toggle('chaos-toggle-pill-active', isActive);
            pill.classList.toggle('bg-[#38D9A9]/20', isActive);
            pill.classList.toggle('text-[#38D9A9]', isActive);
            pill.classList.toggle('border-[#38D9A9]/50', isActive);
            pill.classList.toggle('border-transparent', !isActive);
            pill.classList.toggle('text-[#8E9EA0]', !isActive);
            pill.classList.toggle('hover:text-[#E8F0EC]', !isActive);
          });
        };

        pills.forEach(pill => {
          pill.addEventListener('click', () => {
            const targetMode = pill.getAttribute('data-view-mode') === 'code' ? 'code' : 'decl';
            setViewMode(targetMode);
          });
        });
      }
    });
  }

  setupComparisonCarousel();
  document.addEventListener('astro:page-load', setupComparisonCarousel);
</script>
