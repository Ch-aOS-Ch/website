---
import type { SystemArchitecture, ArchView } from '../../data/architecture/types';
import ArchNodeCard from './ArchNodeCard.astro';
import ArchDrawer from './ArchDrawer.astro';

interface Props {
  arch: SystemArchitecture;
  defaultViewId?: string;
  oppositeArchUrl?: string;
  oppositeArchLabel?: string;
}

const { arch, defaultViewId = 'overview' } = Astro.props;
const currentView: ArchView = arch.views[defaultViewId] || arch.views[arch.overviewViewId];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<div class="arch-explorer relative w-full max-w-[1560px] mx-auto px-4 sm:px-8 lg:px-12 py-6 sm:py-12" data-arch-id={arch.id} data-current-view={currentView.id}>
  
  <!-- Breadcrumbs & Quick Navigation Bar -->
  <div class="arch-nav-bar flex flex-wrap items-center justify-between gap-3 mb-6 sm:mb-8 pb-4">
    <nav class="arch-breadcrumbs flex flex-wrap items-center gap-1.5 sm:gap-2 text-xs sm:text-sm font-mono min-w-0" aria-label="Architecture View Hierarchy">
      <button 
        type="button" 
        class="arch-crumb-btn arch-crumb-root font-bold cursor-pointer transition-colors" 
        data-target-view="overview"
      >
        {arch.systemName}
      </button>
      <span class="arch-crumb-sep">/</span>
      <span id="crumb-current-view" class="arch-crumb-current font-semibold truncate max-w-[200px] sm:max-w-none">
        {currentView.title}
      </span>
    </nav>

    <div class="flex flex-wrap items-center gap-2 sm:gap-3">
      <!-- Return to Overview Button (Shown when in a drilldown) -->
      <button
        type="button"
        id="btn-back-overview"
        class:list={[
          "arch-btn-back items-center gap-2 px-3.5 py-1.5 text-xs font-mono font-bold transition-all cursor-pointer shadow-md min-h-[36px]",
          currentView.id === 'overview' ? 'hidden' : 'inline-flex'
        ]}
        style={currentView.id === 'overview' ? 'display: none;' : 'display: inline-flex;'}
      >
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
        <span>Back to Overview</span>
      </button>
    </div>
  </div>

  <!-- View Header with Prominent Back Action when inside a subsystem -->
  <div class="arch-view-header mb-6 sm:mb-10 text-left">
    <h1 id="view-title" class="arch-header-title text-2xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight mb-3 break-words">
      {currentView.title}
    </h1>

    <p id="view-lead" class="arch-header-lead text-xs sm:text-base lg:text-lg leading-relaxed max-w-4xl">
      {currentView.lead}
    </p>
  </div>

  <!-- Interactive Architecture Board Canvas Viewport Wrapper -->
  <div class="arch-viewport-wrapper relative w-full">
    <!-- Scrollable Architecture Viewport -->
    <div id="arch-viewport" class="arch-viewport w-full overflow-x-auto overflow-y-visible pb-6 overscroll-x-contain">
      <div id="arch-canvas-container" class="relative w-full overflow-visible my-4" style={`min-width: ${currentView.gridCols.includes('repeat(4') ? '1280px' : (currentView.gridCols.includes('repeat(3') ? '1060px' : (currentView.gridCols.includes('repeat(2') ? '720px' : '880px'))};`}>
        <!-- Zone Bounding Boxes Layer (z-0: Behind wires and cards) -->
        <div id="arch-zones-layer" class="absolute inset-0 w-full h-full pointer-events-none z-0 overflow-visible" aria-hidden="true"></div>

        <!-- SVG Connections Layer with Wires (z-1: Behind cards so lines exit cleanly) -->
        <svg id="arch-wires" class="wires-canvas absolute inset-0 w-full h-full pointer-events-none z-1 overflow-visible" aria-hidden="true">
          <defs>
            <marker id="arrow-exec" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto">
              <path d="M 0 1.5 L 8 5 L 0 8.5 z" class="marker-exec" />
            </marker>
            <marker id="arrow-data" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto">
              <path d="M 0 1.5 L 8 5 L 0 8.5 z" class="marker-data" />
            </marker>
            <marker id="arrow-secret" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto">
              <path d="M 0 1.5 L 8 5 L 0 8.5 z" class="marker-secret" />
            </marker>
            <marker id="arrow-flow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto">
              <path d="M 0 1.5 L 8 5 L 0 8.5 z" class="marker-exec" />
            </marker>
            <marker id="arrow-telemetry" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto">
              <path d="M 0 1.5 L 8 5 L 0 8.5 z" class="marker-telemetry" />
            </marker>
          </defs>
        </svg>

        <!-- HTML Zone Title Pills Layer (z-15: Above wires and cards so arrows never pass over pills) -->
        <div id="arch-zone-pills" class="absolute inset-0 w-full h-full pointer-events-none z-15 overflow-visible"></div>

        <!-- HTML Edge Pill Labels Layer (z-20: Cleanly offset from wires) -->
        <div id="arch-wire-labels" class="absolute inset-0 w-full h-full pointer-events-none z-20 overflow-visible"></div>

        <!-- HTML Node Grid Container (z-10: Sits above wires with generous spacing) -->
        <div
          id="arch-board"
          class="arch-board relative grid gap-x-16 sm:gap-x-20 gap-y-32 sm:gap-y-36 z-10 pb-20"
          style={`grid-template-columns: ${currentView.gridCols}; grid-template-areas: ${currentView.gridAreas.map(r => `'${r}'`).join(' ')};`}
        >
          {currentView.nodes.map((node) => (
            <ArchNodeCard node={node} />
          ))}
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom Navigation & Wire Legend -->
  <div class="arch-footer mt-10 sm:mt-14 pt-6 flex flex-wrap items-center justify-between gap-4 text-xs font-mono">
    <div class="flex flex-wrap items-center gap-3 sm:gap-6">
      <span class="arch-legend-title font-bold uppercase tracking-wider">Nodes & Wires:</span>
      <span class="inline-flex items-center gap-1.5">
        <span class="font-semibold text-[var(--arch-accent)]">Deep Subsystem Pipeline</span>
      </span>
      <span class="inline-flex items-center gap-1.5">
        <span class="arch-legend-line-exec w-3.5 h-0.5"></span>
        <span class="arch-legend-text-exec font-semibold">Execution / Operations</span>
      </span>
      <span class="inline-flex items-center gap-1.5">
        <span class="arch-legend-line-secret w-3.5 h-0.5 border-t-2 border-dashed"></span>
        <span class="arch-legend-text-secret font-semibold">Ephemeral Secrets in RAM</span>
      </span>
      <span class="inline-flex items-center gap-1.5">
        <span class="arch-legend-line-data w-3.5 h-0.5 border-t border-dashed"></span>
        <span class="arch-legend-text-data font-semibold">Specification Data</span>
      </span>
    </div>

    <!-- Bottom Back to Overview Button -->
    <button
      type="button"
      id="btn-back-overview-bottom"
      class="btn-back-overview-bottom arch-btn-back items-center gap-2 px-3.5 py-1.5 text-xs font-mono font-bold transition-all cursor-pointer shadow-md hidden"
      style="display: none;"
    >
      <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
        <polyline points="15 18 9 12 15 6"></polyline>
      </svg>
      <span>Back to Overview</span>
    </button>
  </div>

  <!-- Architecture Inspection Slide-Over Drawer -->
  <ArchDrawer />
</div>

<!-- Embedded Architecture Model JSON for Client Navigation -->
<script is:inline id="arch-data-json" type="application/json" set:html={JSON.stringify(arch)} />

<style is:global>
  /* ========================================================================= */
  /* Ch-aOS Architecture Explorer - Complete Semantic CSS Theme System        */
  /* Absolute High-Contrast Tokens: Dark text in light mode, Light in dark     */
  /* ========================================================================= */

  :root,
  [data-theme="dark"],
  html[data-theme="dark"] {
    --arch-bg: #121916;
    --arch-canvas-border: rgba(61, 82, 74, 0.45);
    --arch-title: #E8F0EC;
    --arch-lead: #C1C9D6;
    --arch-muted: #8E9EA0;
    --arch-subtle: #5A7266;

    --arch-accent: #38D9A9;
    --arch-accent-hover: #7CFAD3;
    --arch-accent-bg: rgba(56, 217, 169, 0.12);
    --arch-accent-border: rgba(56, 217, 169, 0.45);

    --arch-pink: #F8A5C2;
    --arch-pink-bg: rgba(248, 165, 194, 0.12);
    --arch-pink-border: rgba(248, 165, 194, 0.45);

    --arch-card-bg: #0C1210;
    --arch-card-border: rgba(61, 82, 74, 0.7);
    --arch-card-border-hover: #38D9A9;
    --arch-card-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
    --arch-card-shadow-hover: 0 4px 18px rgba(56, 217, 169, 0.45);

    --arch-edge-label-bg: #1E2D27;
    --arch-edge-label-text: #E8F0EC;
    --arch-edge-label-border: rgba(61, 82, 74, 0.85);

    --arch-tag-bg: #1E2D27;
    --arch-tag-text: #C1C9D6;
    --arch-tag-border: rgba(61, 82, 74, 0.55);

    --arch-wire-exec: #38D9A9;
    --arch-wire-secret: #F8A5C2;
    --arch-wire-data: #CBD5E1;
    --arch-wire-telemetry: #8E9EA0;

    --arch-zone-border: rgba(56, 217, 169, 0.32);
    --arch-zone-bg: rgba(56, 217, 169, 0.03);
    --arch-zone-pill-bg: #1E2D27;
    --arch-zone-pill-text: #38D9A9;
    --arch-zone-pill-border: rgba(56, 217, 169, 0.55);
    --arch-zone-pill-ring: #121916;

    --arch-btn-back-bg: #1E2D27;
    --arch-btn-back-text: #38D9A9;
    --arch-btn-back-border: rgba(56, 217, 169, 0.6);
    --arch-btn-back-hover-bg: #38D9A9;
    --arch-btn-back-hover-text: #121916;

    --arch-btn-switch-bg: #1E2D27;
    --arch-btn-switch-text: #C1C9D6;
    --arch-btn-switch-border: rgba(61, 82, 74, 0.75);
    --arch-btn-switch-hover-text: #E8F0EC;
    --arch-btn-switch-hover-border: #38D9A9;

    --arch-border-subtle: rgba(61, 82, 74, 0.5);

    --arch-drawer-bg: #18241F;
    --arch-drawer-header-bg: rgba(18, 25, 22, 0.95);
    --arch-drawer-code-bg: #0C1210;
    --arch-drawer-code-text: #E8F0EC;
    --arch-drawer-code-border: rgba(61, 82, 74, 0.6);
  }

  [data-theme="light"],
  html[data-theme="light"] {
    --arch-bg: #F4F8F6;
    --arch-canvas-border: rgba(158, 196, 181, 0.65);
    --arch-title: #14241E;
    --arch-lead: #243830;
    --arch-muted: #3D524A;
    --arch-subtle: #728D80;

    --arch-accent: #137A5B;
    --arch-accent-hover: #09523D;
    --arch-accent-bg: rgba(19, 122, 91, 0.12);
    --arch-accent-border: rgba(19, 122, 91, 0.5);

    --arch-pink: #C92861;
    --arch-pink-bg: rgba(201, 40, 97, 0.1);
    --arch-pink-border: rgba(201, 40, 97, 0.45);

    --arch-card-bg: #F4F8F6;
    --arch-card-border: rgba(142, 179, 164, 0.75);
    --arch-card-border-hover: #137A5B;
    --arch-card-shadow: 0 4px 16px rgba(18, 38, 30, 0.08);
    --arch-card-shadow-hover: 0 4px 18px rgba(19, 122, 91, 0.35);

    --arch-edge-label-bg: #DDF2E8;
    --arch-edge-label-text: #14241E;
    --arch-edge-label-border: rgba(142, 179, 164, 0.85);

    --arch-tag-bg: #D4DFDA;
    --arch-tag-text: #243830;
    --arch-tag-border: rgba(142, 179, 164, 0.7);

    --arch-wire-exec: #137A5B;
    --arch-wire-secret: #C92861;
    --arch-wire-data: #334155;
    --arch-wire-telemetry: #486156;

    --arch-zone-border: rgba(19, 122, 91, 0.42);
    --arch-zone-bg: rgba(19, 122, 91, 0.04);
    --arch-zone-pill-bg: #E8F0EC;
    --arch-zone-pill-text: #137A5B;
    --arch-zone-pill-border: rgba(19, 122, 91, 0.7);
    --arch-zone-pill-ring: #F4F8F6;

    --arch-btn-back-bg: #DDF2E8;
    --arch-btn-back-text: #137A5B;
    --arch-btn-back-border: rgba(19, 122, 91, 0.7);
    --arch-btn-back-hover-bg: #09523D;
    --arch-btn-back-hover-text: #E8F0EC;

    --arch-btn-switch-bg: #E8F0EC;
    --arch-btn-switch-text: #243830;
    --arch-btn-switch-border: rgba(142, 179, 164, 0.85);
    --arch-btn-switch-hover-text: #09523D;
    --arch-btn-switch-hover-border: #137A5B;

    --arch-border-subtle: rgba(158, 196, 181, 0.6);

    --arch-drawer-bg: #F4F8F6;
    --arch-drawer-header-bg: rgba(244, 248, 246, 0.98);
    --arch-drawer-code-bg: #F4F8F6;
    --arch-drawer-code-text: #14241E;
    --arch-drawer-code-border: rgba(158, 196, 181, 0.75);
  }

  /* Navigation Bar & Breadcrumbs */
  .arch-nav-bar {
    border-bottom: 1px solid var(--arch-border-subtle);
  }
  .arch-crumb-root {
    color: var(--arch-title) !important;
  }
  .arch-crumb-root:hover {
    color: var(--arch-accent) !important;
  }
  .arch-crumb-sep {
    color: var(--arch-subtle) !important;
    font-weight: 700 !important;
  }
  .arch-crumb-current {
    color: var(--arch-accent) !important;
    font-weight: 700 !important;
  }

  /* Action Buttons */
  .arch-btn-back {
    background: var(--arch-btn-back-bg) !important;
    color: var(--arch-btn-back-text) !important;
    border: 1px solid var(--arch-btn-back-border) !important;
  }
  .arch-btn-back.hidden,
  .btn-back-overview-bottom.hidden {
    display: none !important;
  }
  .arch-btn-back:hover {
    background: var(--arch-btn-back-hover-bg) !important;
    color: var(--arch-btn-back-hover-text) !important;
  }
  .arch-btn-switch {
    background: var(--arch-btn-switch-bg) !important;
    color: var(--arch-btn-switch-text) !important;
    border: 1px solid var(--arch-btn-switch-border) !important;
  }
  .arch-btn-switch:hover {
    color: var(--arch-btn-switch-hover-text) !important;
    border-color: var(--arch-btn-switch-hover-border) !important;
  }

  /* View Header */
  .arch-kicker-badge {
    background: var(--arch-accent-bg) !important;
    color: var(--arch-accent) !important;
    border: 1px solid var(--arch-accent-border) !important;
  }
  .arch-kicker-dot {
    background-color: var(--arch-accent) !important;
  }
  .arch-header-back-link {
    color: var(--arch-accent) !important;
    font-weight: 600 !important;
  }
  .arch-header-back-link:hover {
    color: var(--arch-accent-hover) !important;
  }
  .arch-header-title {
    color: var(--arch-title) !important;
    font-weight: 800 !important;
  }
  .arch-header-lead {
    color: var(--arch-lead) !important;
  }

  /* Card Elements */
  .arch-node {
    background: var(--arch-card-bg) !important;
    border: 1px solid var(--arch-card-border) !important;
    box-shadow: var(--arch-card-shadow) !important;
    transition: opacity 0.22s cubic-bezier(0.16, 1, 0.3, 1), 
                transform 0.22s cubic-bezier(0.16, 1, 0.3, 1), 
                border-color 0.2s ease, 
                box-shadow 0.2s ease,
                background-color 0.2s ease !important;
    touch-action: pan-x pan-y;
    -webkit-tap-highlight-color: transparent;
  }
  .arch-node:hover {
    border-color: var(--arch-card-border-hover) !important;
    box-shadow: var(--arch-card-shadow-hover) !important;
  }
  .arch-node:focus-visible {
    outline: 2px solid var(--arch-accent);
    outline-offset: 2px;
  }
  .arch-node.dim {
    opacity: 0.25 !important;
    transform: scale(0.99) !important;
    pointer-events: auto !important;
  }
  .arch-node.focused {
    border-color: var(--arch-accent) !important;
    box-shadow: 0 0 28px rgba(56, 217, 169, 0.38) !important;
    transform: translateY(-2px) !important;
    z-index: 30 !important;
  }
  [data-theme="light"] .arch-node.focused,
  html[data-theme="light"] .arch-node.focused {
    box-shadow: 0 0 24px rgba(19, 122, 91, 0.35) !important;
  }

  .arch-node-title {
    color: var(--arch-title) !important;
    transition: color 0.15s ease;
  }
  .arch-node:hover .arch-node-title {
    color: var(--arch-accent) !important;
  }
  .arch-node-subtitle {
    color: var(--arch-lead) !important;
  }

  /* Node Pills */
  .arch-node-pill {
    transition: all 0.15s ease;
  }
  .arch-pill-mint {
    background: var(--arch-accent-bg) !important;
    color: var(--arch-accent) !important;
    border: 1px solid var(--arch-accent-border) !important;
  }
  .arch-pill-pink {
    background: var(--arch-pink-bg) !important;
    color: var(--arch-pink) !important;
    border: 1px solid var(--arch-pink-border) !important;
  }
  .arch-pill-slate {
    background: var(--arch-tag-bg) !important;
    color: var(--arch-muted) !important;
    border: 1px solid var(--arch-tag-border) !important;
  }

  .arch-tag {
    background: var(--arch-tag-bg) !important;
    color: var(--arch-tag-text) !important;
    border: 1px solid var(--arch-tag-border) !important;
  }

  .arch-action-cue-go {
    color: var(--arch-accent) !important;
    font-weight: 600 !important;
  }
  .arch-action-cue-inspect {
    color: var(--arch-muted) !important;
  }

  /* Wires & Markers */
  .arch-wire-path {
    stroke-width: 1.8px;
    transition: opacity 0.2s ease, stroke-width 0.2s ease, stroke 0.2s ease !important;
  }
  .arch-wire-path.wire-exec {
    stroke: var(--arch-wire-exec);
  }
  .arch-wire-path.wire-secret {
    stroke: var(--arch-wire-secret);
  }
  .arch-wire-path.wire-data {
    stroke: var(--arch-wire-data);
  }
  .arch-wire-path.wire-telemetry {
    stroke: var(--arch-wire-telemetry);
  }
  .marker-exec {
    fill: var(--arch-wire-exec);
  }
  .marker-data {
    fill: var(--arch-wire-data);
  }
  .marker-secret {
    fill: var(--arch-wire-secret);
  }
  .marker-telemetry {
    fill: var(--arch-wire-telemetry);
  }

  .arch-wire-path.dim {
    opacity: 0.08 !important;
  }
  .arch-wire-path.on {
    stroke-width: 3.5px !important;
    opacity: 1 !important;
  }

  /* Edge Labels with Dynamic Away-From-Card Gliding Animation */
  .arch-edge-label {
    background: var(--arch-edge-label-bg) !important;
    color: var(--arch-edge-label-text) !important;
    border: 1px solid var(--arch-edge-label-border) !important;
    box-shadow: var(--arch-card-shadow) !important;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1),
                opacity 0.22s ease,
                border-color 0.2s ease,
                color 0.2s ease,
                box-shadow 0.2s ease !important;
  }
  .arch-edge-label.dim {
    opacity: 0.04 !important;
    pointer-events: none !important;
  }
  .arch-edge-label.on {
    border-color: var(--arch-accent) !important;
    color: var(--arch-accent) !important;
    opacity: 1 !important;
    z-index: 40 !important;
    box-shadow: 0 0 16px rgba(56, 217, 169, 0.45) !important;
  }
  [data-theme="light"] .arch-edge-label.on,
  html[data-theme="light"] .arch-edge-label.on {
    box-shadow: 0 0 16px rgba(19, 122, 91, 0.35) !important;
  }
  
  .arch-zone {
    position: absolute;
    z-index: 0;
    border: 1.5px dashed var(--arch-zone-border);
    border-radius: 0px;
    background: var(--arch-zone-bg);
    pointer-events: none;
    transition: border-color 0.25s ease, background 0.25s ease;
  }
  .arch-zone-pill {
    position: absolute;
    z-index: 15;
    padding: 2px 10px;
    font-family: monospace;
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    background: var(--arch-zone-pill-bg) !important;
    color: var(--arch-zone-pill-text) !important;
    border: 1px solid var(--arch-zone-pill-border) !important;
    box-shadow: 0 0 0 3px var(--arch-zone-pill-ring) !important;
    white-space: nowrap;
    pointer-events: none;
    transition: background 0.25s ease, color 0.25s ease, border-color 0.25s ease;
  }

  /* Bottom Legend & Footer */
  .arch-footer {
    border-top: 1px solid var(--arch-border-subtle) !important;
    color: var(--arch-lead) !important;
  }
  .arch-legend-title {
    color: var(--arch-title) !important;
    font-weight: 700 !important;
  }
  .arch-legend-line-exec {
    background-color: var(--arch-wire-exec) !important;
  }
  .arch-legend-text-exec {
    color: var(--arch-title) !important;
    font-weight: 600 !important;
  }
  .arch-legend-line-secret {
    border-color: var(--arch-wire-secret) !important;
  }
  .arch-legend-text-secret {
    color: var(--arch-pink) !important;
    font-weight: 600 !important;
  }
  .arch-legend-line-data {
    border-color: var(--arch-wire-data) !important;
  }
  .arch-legend-text-data {
    color: var(--arch-lead) !important;
    font-weight: 600 !important;
  }
  .arch-legend-back-btn {
    color: var(--arch-accent) !important;
    font-weight: 700 !important;
  }
  .arch-footer-note {
    color: var(--arch-lead) !important;
  }

  /* Subsystem Card Distinct Indication */
  .arch-node.is-subsystem {
    border-left: 3px solid var(--arch-accent) !important;
  }
  .arch-subsystem-pill {
    background: var(--arch-accent-bg) !important;
    border: 1px solid var(--arch-accent-border) !important;
    color: var(--arch-accent) !important;
  }

  /* Slide-over Inspection Drawer */
