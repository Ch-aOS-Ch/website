</style>

<script is:inline>
  (function () {
    const rawData = document.getElementById('arch-data-json')?.textContent;
    if (!rawData) return;

    const arch = JSON.parse(rawData);
    const explorer = document.querySelector('.arch-explorer');
    const board = document.getElementById('arch-board');
    const svgWires = document.getElementById('arch-wires');
    const wireLabels = document.getElementById('arch-wire-labels');
    const zonesLayer = document.getElementById('arch-zones-layer');
    const zonePillsLayer = document.getElementById('arch-zone-pills');
    const canvasContainer = document.getElementById('arch-canvas-container');
    const archViewport = document.getElementById('arch-viewport');
    const drawer = document.getElementById('arch-drawer');
    const drawerBackdrop = document.getElementById('arch-drawer-backdrop');
    const drawerBody = document.getElementById('drawer-body');
    const drawerPill = document.getElementById('drawer-pill');
    const drawerClose = document.getElementById('arch-drawer-close');
    const crumbCurrent = document.getElementById('crumb-current-view');
    const viewKicker = document.getElementById('view-kicker');
    const viewTitle = document.getElementById('view-title');
    const viewLead = document.getElementById('view-lead');
    const viewFooterNote = document.getElementById('arch-view-footer-note');
    const btnBackOverview = document.getElementById('btn-back-overview');
    const subsystemBackBadge = document.getElementById('subsystem-back-badge');
    const btnBackOverviewBottom = document.getElementById('btn-back-overview-bottom') || document.querySelector('.btn-back-overview-bottom');

    let currentViewId = explorer?.dataset.currentView || 'overview';
    let focusedNodeId = null;

    function updateCanvasMinWidth(view) {
      if (!canvasContainer || !view) return;
      if (view.gridCols && view.gridCols.includes('repeat(4')) {
        canvasContainer.style.minWidth = '1280px';
      } else if (view.gridCols && view.gridCols.includes('repeat(3')) {
        canvasContainer.style.minWidth = '1060px';
      } else if (view.gridCols && view.gridCols.includes('repeat(2')) {
        canvasContainer.style.minWidth = '720px';
      } else {
        canvasContainer.style.minWidth = '880px';
      }
    }

    /* ---------- Orthogonal Arrow Routing & Card Collision Avoidance ---------- */
    const NV = { l: [-1, 0], r: [1, 0], t: [0, -1], b: [0, 1] };

    function box(el) {
      return {
        id: el.dataset.nodeId,
        x: el.offsetLeft,
        y: el.offsetTop,
        w: el.offsetWidth,
        h: el.offsetHeight,
      };
    }

    const horiz = s => s === 'l' || s === 'r';
    const along = (r, s, f) => horiz(s) ? r.y + r.h * f : r.x + r.w * f;

    function ends(a, b, sa, sb, e, zonePillBoxes = []) {
      let ua = null, ub = null;
      if (horiz(sa) === horiz(sb) && sa !== sb) {
        const H = horiz(sa);
        const lo = H ? Math.max(a.y, b.y) : Math.max(a.x, b.x);
        const hi = H ? Math.min(a.y + a.h, b.y + b.h) : Math.min(a.x + a.w, b.x + b.w);
        if (hi - lo > 20) ua = ub = (lo + hi) / 2;
      }
      if (e?.fa != null) ua = along(a, sa, e.fa);
      if (e?.fb != null) ub = along(b, sb, e.fb);
      if (e?.off) {
        ua = (ua ?? along(a, sa, 0.5)) + e.off;
        ub = (ub ?? along(b, sb, 0.5)) + e.off;
      }

      // Avoid zone title pills collision on top edges
      if (sb === 't' && zonePillBoxes && zonePillBoxes.length > 0) {
        const currentUb = ub ?? along(b, sb, 0.5);
        for (const zp of zonePillBoxes) {
          if (zp.y < b.y && zp.y > b.y - 55) {
            if (currentUb >= zp.x - 12 && currentUb <= zp.x + zp.w + 14) {
              const clearX = zp.x + zp.w + 18;
              if (clearX < b.x + b.w - 16) {
                ub = clearX;
                if (horiz(sa) === horiz(sb) && sa !== sb && Math.abs(a.x - b.x) < 25) {
                  ua = clearX;
                }
              }
            }
          }
        }
      }

      const pt = (r, s, u) => horiz(s) 
        ? [s === 'l' ? r.x : r.x + r.w, u ?? r.y + r.h / 2]
        : [u ?? r.x + r.w / 2, s === 't' ? r.y : r.y + r.h];
      return [pt(a, sa, ua), pt(b, sb, ub)];
    }

    function computeGutters(allBoxList) {
      const rowMap = new Map();
      const colMap = new Map();

      allBoxList.forEach(b => {
        let rKey = null;
        for (const key of rowMap.keys()) {
          if (Math.abs(key - b.y) < 35) {
            rKey = key;
            break;
          }
        }
        if (rKey === null) {
          rowMap.set(b.y, { top: b.y, bottom: b.y + b.h });
        } else {
          const r = rowMap.get(rKey);
          r.top = Math.min(r.top, b.y);
          r.bottom = Math.max(r.bottom, b.y + b.h);
        }

        let cKey = null;
        for (const key of colMap.keys()) {
          if (Math.abs(key - b.x) < 35) {
            cKey = key;
            break;
          }
        }
        if (cKey === null) {
          colMap.set(b.x, { left: b.x, right: b.x + b.w });
        } else {
          const c = colMap.get(cKey);
          c.left = Math.min(c.left, b.x);
          c.right = Math.max(c.right, b.x + b.w);
        }
      });

      const rows = Array.from(rowMap.values()).sort((r1, r2) => r1.top - r2.top);
      const cols = Array.from(colMap.values()).sort((c1, c2) => c1.left - c2.left);

      const guttersY = [];
      const minY = rows.length > 0 ? rows[0].top : 0;
      const maxY = rows.length > 0 ? rows[rows.length - 1].bottom : 0;
      guttersY.push(minY - 32);
      for (let i = 0; i < rows.length - 1; i++) {
        guttersY.push((rows[i].bottom + rows[i + 1].top) / 2);
      }
      guttersY.push(maxY + 32);

      const guttersX = [];
      const minX = cols.length > 0 ? cols[0].left : 0;
      const maxX = cols.length > 0 ? cols[cols.length - 1].right : 0;
      guttersX.push(minX - 32);
      for (let i = 0; i < cols.length - 1; i++) {
        guttersX.push((cols[i].right + cols[i + 1].left) / 2);
      }
      guttersX.push(maxX + 32);

      return { guttersX, guttersY };
    }

    function segmentIntersectsBox(x1, y1, x2, y2, obs, pad = 8) {
      const minX = Math.min(x1, x2);
      const maxX = Math.max(x1, x2);
      const minY = Math.min(y1, y2);
      const maxY = Math.max(y1, y2);

      const bx1 = obs.x - pad;
      const bx2 = obs.x + obs.w + pad;
      const by1 = obs.y - pad;
      const by2 = obs.y + obs.h + pad;

      if (maxX <= bx1 || minX >= bx2 || maxY <= by1 || minY >= by2) {
        return false;
      }

      if (Math.abs(y1 - y2) < 1) {
        return y1 > by1 && y1 < by2 && maxX > bx1 && minX < bx2;
      }

      if (Math.abs(x1 - x2) < 1) {
        return x1 > bx1 && x1 < bx2 && maxY > by1 && minY < by2;
      }

      return true;
    }

    function segmentIntersectsAnyBox(x1, y1, x2, y2, obstacles, pad = 8) {
      for (const obs of obstacles) {
        if (segmentIntersectsBox(x1, y1, x2, y2, obs, pad)) return true;
      }
      return false;
    }

    function pathIntersects(pts, obstacles, pad = 8) {
      for (let i = 0; i < pts.length - 1; i++) {
        const x1 = pts[i][0], y1 = pts[i][1];
        const x2 = pts[i + 1][0], y2 = pts[i + 1][1];
        for (const obs of obstacles) {
          if (segmentIntersectsBox(x1, y1, x2, y2, obs, pad)) {
            return true;
          }
        }
      }
      return false;
    }

    function simplify(rawPts) {
      const out = [];
      for (const p of rawPts) {
        const z = out[out.length - 1];
        if (z && Math.hypot(p[0] - z[0], p[1] - z[1]) < 0.5) continue;
        if (out.length >= 2) {
          const y = out[out.length - 2];
          if ((Math.abs(y[0] - z[0]) < 0.5 && Math.abs(z[0] - p[0]) < 0.5) ||
              (Math.abs(y[1] - z[1]) < 0.5 && Math.abs(z[1] - p[1]) < 0.5)) {
            out.pop();
          }
        }
        out.push(p);
      }
      return out;
    }

    function routeWithObstacleAvoidance(a, b, edge, obstacles, guttersX, guttersY, edgeIdx, zonePillBoxes = []) {
      const cxA = a.x + a.w / 2;
      const cyA = a.y + a.h / 2;
      const cxB = b.x + b.w / 2;
      const cyB = b.y + b.h / 2;
      const dx = cxB - cxA;
      const dy = cyB - cyA;

      const gOffset = ((edgeIdx % 5) - 2) * 6;

      const primarySides = [];
      if (Math.abs(dy) > Math.abs(dx) * 0.8) {
        if (dy > 0) {
          primarySides.push(['b', 't'], ['r', 't'], ['l', 't'], ['r', 'l'], ['l', 'r'], ['b', 'r'], ['b', 'l']);
        } else {
          primarySides.push(['t', 'b'], ['r', 'b'], ['l', 'b'], ['r', 'l'], ['l', 'r'], ['t', 'r'], ['t', 'l']);
        }
      } else {
        if (dx > 0) {
          primarySides.push(['r', 'l'], ['b', 'l'], ['t', 'l'], ['r', 't'], ['r', 'b'], ['b', 't']);
        } else {
          primarySides.push(['l', 'r'], ['b', 'r'], ['t', 'r'], ['l', 't'], ['l', 'b'], ['b', 't']);
        }
      }

      const allSides = ['r', 'b', 'l', 't'];
      for (const sa of allSides) {
        for (const sb of allSides) {
          if (!primarySides.some(pair => pair[0] === sa && pair[1] === sb)) {
            primarySides.push([sa, sb]);
          }
        }
      }

      let bestPath = null;
      let minCost = Infinity;

      for (const [sa, sb] of primarySides) {
        const n0 = NV[sa], n3 = NV[sb];
        const stubDist = 18;
        const [p0, p3] = ends(a, b, sa, sb, edge, zonePillBoxes);
        const p1 = [p0[0] + n0[0] * stubDist, p0[1] + n0[1] * stubDist];
        const p2 = [p3[0] + n3[0] * stubDist, p3[1] + n3[1] * stubDist];
        const q3 = [p3[0] + n3[0] * 2, p3[1] + n3[1] * 2];

        if (segmentIntersectsAnyBox(p0[0], p0[1], p1[0], p1[1], obstacles, 6) ||
            segmentIntersectsAnyBox(p2[0], p2[1], p3[0], p3[1], obstacles, 6)) {
          continue;
        }

        const candidateWays = [];

        if (Math.abs(p1[0] - p2[0]) < 1 || Math.abs(p1[1] - p2[1]) < 1) {
          candidateWays.push([p0, p1, p2, q3]);
        }

        candidateWays.push([p0, p1, [p2[0], p1[1]], p2, q3]);
        candidateWays.push([p0, p1, [p1[0], p2[1]], p2, q3]);

        if (n0[0] !== 0 && n3[0] !== 0) {
          const mx = (p1[0] + p2[0]) / 2;
          candidateWays.push([p0, p1, [mx, p1[1]], [mx, p2[1]], p2, q3]);
        } else if (n0[1] !== 0 && n3[1] !== 0) {
          const my = (p1[1] + p2[1]) / 2;
          candidateWays.push([p0, p1, [p1[0], my], [p2[0], my], p2, q3]);
        }

        for (const gy of guttersY) {
          const adjGy = gy + gOffset;
          candidateWays.push([p0, p1, [p1[0], adjGy], [p2[0], adjGy], p2, q3]);
        }
        for (const gx of guttersX) {
          const adjGx = gx + gOffset;
          candidateWays.push([p0, p1, [adjGx, p1[1]], [adjGx, p2[1]], p2, q3]);
        }

        for (const gx of guttersX) {
          const adjGx = gx + gOffset;
          for (const gy of guttersY) {
            const adjGy = gy + gOffset;
            candidateWays.push([p0, p1, [p1[0], adjGy], [adjGx, adjGy], [adjGx, p2[1]], p2, q3]);
            candidateWays.push([p0, p1, [adjGx, p1[1]], [adjGx, adjGy], [p2[0], adjGy], p2, q3]);
          }
        }

        for (const rawPath of candidateWays) {
          const path = simplify(rawPath);
          if (!pathIntersects(path, obstacles, 8)) {
            let clipsSelf = false;
            for (let i = 1; i < path.length - 2; i++) {
              if (segmentIntersectsBox(path[i][0], path[i][1], path[i + 1][0], path[i + 1][1], a, 6) ||
                  segmentIntersectsBox(path[i][0], path[i][1], path[i + 1][0], path[i + 1][1], b, 6)) {
                clipsSelf = true;
                break;
              }
            }
            if (clipsSelf) continue;

            let len = 0;
            for (let i = 0; i < path.length - 1; i++) {
              len += Math.hypot(path[i + 1][0] - path[i][0], path[i + 1][1] - path[i][1]);
            }
            const bends = path.length - 2;
            const cost = len + bends * 45;

            if (cost < minCost) {
              minCost = cost;
              bestPath = path;
            }
          }
        }

        if (bestPath && minCost < 650) {
          break;
        }
      }

      return bestPath || [ [a.x + a.w / 2, a.y + a.h], [b.x + b.w / 2, b.y] ];
    }

    function pathD(pts, r = 12) {
      let d = `M ${pts[0][0]},${pts[0][1]}`;
      for (let i = 1; i < pts.length - 1; i++) {
        const a = pts[i - 1], p = pts[i], b = pts[i + 1];
        const la = Math.hypot(a[0] - p[0], a[1] - p[1]), lb = Math.hypot(b[0] - p[0], b[1] - p[1]);
        const rr = Math.min(r, la / 2, lb / 2);
        const q1 = [p[0] + (a[0] - p[0]) / la * rr, p[1] + (a[1] - p[1]) / la * rr];
        const q2 = [p[0] + (b[0] - p[0]) / lb * rr, p[1] + (b[1] - p[1]) / lb * rr];
        d += ` L ${q1[0]},${q1[1]} Q ${p[0]},${p[1]} ${q2[0]},${q2[1]}`;
      }
      const z = pts[pts.length - 1];
      return d + ` L ${z[0]},${z[1]}`;
    }

    /* ---------- Hover Dimming & Dynamic Label Gliding Effect ---------- */
    function setFocusNode(id) {
      if (focusedNodeId === id) return;
      focusedNodeId = id;
      const view = arch.views[currentViewId];
      if (!view) return;

      const relatedNodes = new Set(id ? [id] : []);
      if (id && view.edges) {
        view.edges.forEach(e => {
          if (e.from === id || e.to === id) {
            relatedNodes.add(e.from);
            relatedNodes.add(e.to);
          }
        });
      }

      // Dim non-related cards across all views (overview or subsystem)
      board.querySelectorAll('[data-node-id]').forEach(card => {
        const cardId = card.dataset.nodeId;
        if (id) {
          const isRelated = relatedNodes.has(cardId);
          card.classList.toggle('dim', !isRelated);
          card.classList.toggle('focused', cardId === id);
        } else {
          card.classList.remove('dim', 'focused');
        }
      });

      // Highlight/dim SVG wires
      svgWires.querySelectorAll('.arch-wire-path').forEach(path => {
        const f = path.dataset.from;
        const t = path.dataset.to;
        if (id) {
          const isConnected = (f === id || t === id);
          path.classList.toggle('on', isConnected);
          path.classList.toggle('dim', !isConnected);
          if (isConnected) svgWires.appendChild(path);
        } else {
          path.classList.remove('on', 'dim');
        }
      });

      // Highlight/dim Edge Labels and smoothly animate connected label away from focused card
      if (wireLabels) {
        wireLabels.querySelectorAll('.arch-edge-label').forEach(lbl => {
          const f = lbl.dataset.from;
          const t = lbl.dataset.to;
          const isConnected = (f === id || t === id);
          const baseTrans = lbl.dataset.baseTransform || 'translate(-50%, -50%)';
          if (id) {
            lbl.classList.toggle('on', isConnected);
            lbl.classList.toggle('dim', !isConnected);
            if (isConnected) {
              const card = board.querySelector(`[data-node-id="${id}"]`);
              if (card) {
                const cx = card.offsetLeft + card.offsetWidth / 2;
                const cy = card.offsetTop + card.offsetHeight / 2;
                const lx = parseFloat(lbl.dataset.baseX);
                const ly = parseFloat(lbl.dataset.baseY);
                const dx = lx - cx;
                const dy = ly - cy;
                const shiftDist = 42;
                let shiftX = 0, shiftY = 0;
                if (lbl.dataset.isHorizontal === '1') {
                  shiftX = dx >= 0 ? shiftDist : -shiftDist;
                } else {
                  shiftY = dy >= 0 ? shiftDist : -shiftDist;
                }
                lbl.style.transform = `${baseTrans} translate(${shiftX}px, ${shiftY}px)`;
              }
            } else {
              lbl.style.transform = baseTrans;
            }
          } else {
            lbl.classList.remove('on', 'dim');
            lbl.style.transform = baseTrans;
          }
        });
      }
    }

    function bindCardHover(card) {
      const handleEnter = () => {
        const id = card.dataset.nodeId;
        if (id) setFocusNode(id);
      };

      const handleLeave = (e) => {
        const nextCard = e?.relatedTarget?.closest?.('[data-node-id]');
        if (!nextCard) {
          setFocusNode(null);
        }
      };

      // Standard desktop hover
      card.addEventListener('mouseenter', handleEnter);
      card.addEventListener('mouseleave', handleLeave);

      // Pointer events for mouse/pen input
      card.addEventListener('pointerenter', (e) => {
        if (e.pointerType !== 'touch') handleEnter();
      });
      card.addEventListener('pointerleave', (e) => {
        if (e.pointerType !== 'touch') handleLeave(e);
      });

      // Keyboard navigation
      card.addEventListener('focus', handleEnter);
      card.addEventListener('blur', () => {
        setFocusNode(null);
      });
    }

    function renderView(viewId) {
      const view = arch.views[viewId];
      if (!view) return;

      currentViewId = viewId;
      focusedNodeId = null;
      setFocusNode(null);
      explorer.dataset.currentView = viewId;
      if (crumbCurrent) crumbCurrent.textContent = view.title;
      if (viewKicker) viewKicker.textContent = view.kicker;
      if (viewTitle) viewTitle.textContent = view.title;
      if (viewLead) viewLead.textContent = view.lead;
      if (viewFooterNote) viewFooterNote.textContent = view.footerNote || '';

      const isSubsystem = viewId !== 'overview';
      if (btnBackOverview) {
        btnBackOverview.style.display = isSubsystem ? 'inline-flex' : 'none';
        btnBackOverview.classList.toggle('hidden', !isSubsystem);
      }
      if (btnBackOverviewBottom) {
        btnBackOverviewBottom.style.display = isSubsystem ? 'inline-block' : 'none';
        btnBackOverviewBottom.classList.toggle('hidden', !isSubsystem);
      }

      // Update grid layout & responsive minimum width
      board.style.gridTemplateColumns = view.gridCols;
      board.style.gridTemplateAreas = view.gridAreas.map(r => `'${r}'`).join(' ');
      updateCanvasMinWidth(view);
      if (archViewport) archViewport.scrollLeft = 0;

      // Render cards using semantic CSS classes (no hardcoded inline theme colors)
      board.innerHTML = '';
      view.nodes.forEach(node => {
        const hasDrilldown = Boolean(node.go);
        const card = document.createElement('button');
        card.type = 'button';
        card.className = `arch-node group relative flex flex-col justify-between text-left p-3.5 sm:p-6 cursor-pointer w-full h-full min-h-[84px] sm:min-h-[160px] rounded-none focus-visible:outline-2 focus-visible:outline-[var(--arch-accent)] focus-visible:outline-offset-2 ${hasDrilldown ? 'is-subsystem' : ''}`;
        card.dataset.nodeId = node.id;
        card.dataset.go = node.go || '';
        card.style.gridArea = node.gridArea;
        card.setAttribute('aria-label', `${node.title}. ${hasDrilldown ? 'Subsystem architecture pipeline. Click to explore subsystem' : 'Click to inspect architecture specifications in sidebar'}`);

        const badgesHtml = (node.badges || [])
          .filter(b => b.toLowerCase() !== 'subsystem')
          .map(b => `<span class="arch-tag hidden sm:inline-block text-[9.5px] sm:text-[10px] font-mono font-bold uppercase tracking-wider px-2 py-0.5 rounded-none">${b}</span>`)
          .join('');

        const tagsHtml = (node.tags || []).map(t => `<span class="arch-tag text-[9px] sm:text-[10px] font-mono px-1.5 py-0.5 rounded-none">${t}</span>`).join('');
        
        const cueHtml = hasDrilldown 
          ? `<span class="arch-action-cue-go inline-flex items-center gap-1 text-[10px] sm:text-[11px] font-mono font-bold shrink-0 text-[var(--arch-accent)] group-hover:translate-x-0.5 transition-transform"><span class="hidden sm:inline">Explore Subsystem</span><span class="sm:hidden">Subsystem</span><svg class="w-3 h-3 sm:w-3.5 sm:h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg></span>`
          : `<span class="arch-action-cue-inspect inline-flex items-center gap-1 text-[9.5px] sm:text-[10px] font-mono text-[var(--arch-muted)] shrink-0"><span class="hidden sm:inline">Inspect Details</span><span class="sm:hidden">Inspect</span><svg class="w-2.5 h-2.5 sm:w-3 sm:h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg></span>`;

        card.innerHTML = `
          <div class="flex items-start justify-between gap-2 sm:gap-3 mb-1.5 sm:mb-2">
            <h3 class="arch-node-title text-sm sm:text-lg font-bold leading-tight flex-1">
              ${node.title}
            </h3>
            <div class="flex items-center gap-1.5 shrink-0 mt-0.5">
              ${badgesHtml}
            </div>
          </div>
          <p class="arch-node-subtitle hidden sm:block text-xs sm:text-[13px] leading-relaxed mb-4 flex-1">
            ${node.subtitle}
          </p>
          <div class="pt-2 sm:pt-3 border-t border-[var(--arch-border-subtle)] flex items-center justify-between gap-2 mt-auto">
            <div class="flex flex-wrap gap-1 sm:gap-1.5">${tagsHtml}</div>
            ${cueHtml}
          </div>
        `;
        bindCardHover(card);
        board.appendChild(card);
      });

      // Recalculate wires & zones
      requestAnimationFrame(drawWires);
      closeDrawer();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function drawWires() {
      const view = arch.views[currentViewId];
      if (!view || !svgWires) return;

      const defs = svgWires.querySelector('defs');
      svgWires.innerHTML = '';
      if (defs) svgWires.appendChild(defs);
      if (wireLabels) wireLabels.innerHTML = '';
      if (zonesLayer) zonesLayer.innerHTML = '';
      if (zonePillsLayer) zonePillsLayer.innerHTML = '';

      const nodeElements = {};
      board.querySelectorAll('[data-node-id]').forEach(el => {
        nodeElements[el.dataset.nodeId] = el;
      });

      // 1. Draw Zones (Bounding boxes behind cards) & Zone Pills (Layer above wires)
      const zonePillBoxes = [];
      if (view.zones && zonesLayer) {
        view.zones.forEach((z) => {
          const els = z.nodeIds.map(id => nodeElements[id]).filter(Boolean);
          if (els.length === 0) return;

          const boxes = els.map(box);
          const x0 = Math.min(...boxes.map(b => b.x)) - 16;
          const y0 = Math.min(...boxes.map(b => b.y)) - 28;
          const x1 = Math.max(...boxes.map(b => b.x + b.w)) + 16;
          const y1 = Math.max(...boxes.map(b => b.y + b.h)) + 16;

          const zoneEl = document.createElement('div');
          zoneEl.className = 'arch-zone';
          zoneEl.style.left = `${x0}px`;
          zoneEl.style.top = `${y0}px`;
          zoneEl.style.width = `${x1 - x0}px`;
          zoneEl.style.height = `${y1 - y0}px`;
          zonesLayer.appendChild(zoneEl);

          const pill = document.createElement('span');
          pill.className = 'arch-zone-pill';
          pill.textContent = z.title;
          pill.style.left = `${x0 + 18}px`;
          pill.style.top = `${y0 - 11}px`;

          if (zonePillsLayer) {
            zonePillsLayer.appendChild(pill);
          } else {
            zoneEl.appendChild(pill);
          }

          const pillW = pill.offsetWidth || (z.title.length * 7.5 + 24);
          const pillH = pill.offsetHeight || 22;
          zonePillBoxes.push({
            id: 'zone-pill-' + z.title,
            x: x0 + 18,
            y: y0 - 11,
            w: pillW,
            h: pillH,
          });
        });
      }

      // 2. Draw Edges with Card & Zone Pill Obstacle Avoidance & Wire Label Pills
      const allBoxList = Object.values(nodeElements).map(box);
      const { guttersX, guttersY } = computeGutters(allBoxList);
      const obstacleBoxes = [
        ...allBoxList,
        ...zonePillBoxes,
      ];

      view.edges.forEach((edge, edgeIdx) => {
        const fromEl = nodeElements[edge.from];
        const toEl = nodeElements[edge.to];
        if (!fromEl || !toEl) return;

        const a = box(fromEl);
        const b = box(toEl);
        const edgeObstacles = obstacleBoxes.filter(o => o.id !== edge.from && o.id !== edge.to);

        const pts = routeWithObstacleAvoidance(a, b, edge, edgeObstacles, guttersX, guttersY, edgeIdx, zonePillBoxes);
        const d = pathD(pts, 10);

        const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
        let wireTypeClass = 'wire-exec';
        let marker = 'url(#arrow-exec)';
        let strokeDash = 'none';

        if (edge.type === 'secret') {
          wireTypeClass = 'wire-secret';
          marker = 'url(#arrow-secret)';
          strokeDash = '5 4';
        } else if (edge.type === 'data') {
          wireTypeClass = 'wire-data';
          marker = 'url(#arrow-data)';
          strokeDash = '4 3';
        } else if (edge.type === 'telemetry') {
          wireTypeClass = 'wire-telemetry';
          marker = 'url(#arrow-telemetry)';
        }

        path.setAttribute('d', d);
        path.setAttribute('fill', 'none');
        path.setAttribute('stroke-dasharray', strokeDash);
        path.setAttribute('marker-end', marker);
        path.dataset.from = edge.from;
        path.dataset.to = edge.to;
        path.classList.add('arch-wire-path', wireTypeClass);

        if (edge.bidirectional) {
          path.setAttribute('marker-start', marker);
        }
        svgWires.appendChild(path);

        // Place pill label cleanly along the longest wire segment (in the gutter)
        if (edge.label && wireLabels && pts.length >= 2) {
          let longestLen = 0;
          let bestIdx = 0;
          for (let i = 0; i < pts.length - 1; i++) {
            const len = Math.hypot(pts[i + 1][0] - pts[i][0], pts[i + 1][1] - pts[i][1]);
            if (len > longestLen) {
              longestLen = len;
              bestIdx = i;
            }
          }
          const u = pts[bestIdx], w = pts[bestIdx + 1];
          const isLastSegment = (bestIdx === pts.length - 2);
          
          const tFactor = isLastSegment ? 0.35 : 0.5;
          const midX = u[0] + (w[0] - u[0]) * tFactor;
          const midY = u[1] + (w[1] - u[1]) * tFactor;

          const isHorizontal = Math.abs(u[1] - w[1]) < 2;
          const isVertical = Math.abs(u[0] - w[0]) < 2;

          let posX = midX;
          let posY = midY;
          let transformStyle = 'translate(-50%, -50%)';

          if (isHorizontal) {
            posY = midY - 14;
            transformStyle = 'translate(-50%, -50%)';
          } else if (isVertical) {
            posX = midX + 14;
            transformStyle = 'translate(0, -50%)';
          }

          const label = document.createElement('div');
          label.className = 'arch-edge-label absolute px-2.5 py-0.5 text-[9.5px] sm:text-[10px] font-mono font-semibold whitespace-nowrap z-20 pointer-events-none';
          label.dataset.from = edge.from;
          label.dataset.to = edge.to;
          label.dataset.baseX = String(posX);
          label.dataset.baseY = String(posY);
          label.dataset.baseTransform = transformStyle;
          label.dataset.isHorizontal = isHorizontal ? '1' : '0';
          label.style.left = `${posX}px`;
          label.style.top = `${posY}px`;
          label.style.transform = transformStyle;
          label.textContent = edge.label;
          wireLabels.appendChild(label);
        }
      });
    }

    function openNodeDrawer(node) {
      if (node?.id) setFocusNode(node.id);
      if (drawerPill) drawerPill.textContent = node.pill || 'Component Specification';

      let detailsHtml = `
        <div class="space-y-4">
          <div>
            <h2 class="arch-drawer-title text-2xl font-extrabold leading-tight mb-2">
              ${node.title}
            </h2>
            <p class="arch-drawer-subtitle text-sm leading-relaxed">
              ${node.subtitle}
            </p>
          </div>
      `;

      if (node.details?.howItWorks) {
        detailsHtml += `
          <div class="pt-4 arch-drawer-divider">
            <h4 class="arch-drawer-section-title-mint text-xs font-mono font-bold uppercase tracking-wider mb-2">
              How It Works
            </h4>
            <p class="arch-drawer-text text-xs leading-relaxed">
              ${node.details.howItWorks}
            </p>
          </div>
        `;
      }

      if (node.details?.whyThisWay && node.details.whyThisWay.length > 0) {
        detailsHtml += `
          <div class="pt-4 arch-drawer-divider">
            <h4 class="arch-drawer-section-title-pink text-xs font-mono font-bold uppercase tracking-wider mb-2">
              Architectural Rationale
            </h4>
            <ul class="space-y-2 text-xs arch-drawer-text">
              ${node.details.whyThisWay.map(r => `<li class="flex items-start gap-2"><span class="arch-drawer-section-title-mint font-bold">›</span><span>${r}</span></li>`).join('')}
            </ul>
          </div>
        `;
      }

      if (node.details?.technicalFacts && node.details.technicalFacts.length > 0) {
        detailsHtml += `
          <div class="pt-4 arch-drawer-divider">
            <h4 class="arch-drawer-section-title-text text-xs font-mono font-bold uppercase tracking-wider mb-2">
              Technical Facts & Guarantees
            </h4>
            <ul class="space-y-1.5 text-xs arch-drawer-text">
              ${node.details.technicalFacts.map(f => `<li class="flex items-start gap-2"><span class="arch-drawer-code-title">▪</span><span>${f}</span></li>`).join('')}
            </ul>
          </div>
        `;
      }

      if (node.details?.codeSnippets && node.details.codeSnippets.length > 0) {
        detailsHtml += `
          <div class="pt-4 arch-drawer-divider">
            <h4 class="arch-drawer-section-title-mint text-xs font-mono font-bold uppercase tracking-wider mb-2">
              Implementation Blueprint
            </h4>
            <div class="space-y-3">
              ${node.details.codeSnippets.map(snip => `
                <div>
                  <div class="arch-drawer-code-title text-[10px] font-mono mb-1">${snip.title}</div>
                  <pre class="arch-drawer-code-box p-3 text-[11px] font-mono overflow-x-auto"><code>${snip.code}</code></pre>
                </div>
              `).join('')}
            </div>
          </div>
        `;
      }

      if (node.details?.relatedFiles && node.details.relatedFiles.length > 0) {
        detailsHtml += `
          <div class="pt-4 arch-drawer-divider">
            <h4 class="arch-drawer-section-title-text text-xs font-mono font-bold uppercase tracking-wider mb-2">
              Repository Sources
            </h4>
            <div class="space-y-1">
              ${node.details.relatedFiles.map(f => `
                <div class="arch-drawer-source-link text-xs font-mono flex items-center gap-1.5">
                  <svg class="w-3 h-3 opacity-70" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M13 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"></path>
                    <polyline points="13 2 13 9 20 9"></polyline>
                  </svg>
                  <span>${f}</span>
                </div>
              `).join('')}
            </div>
          </div>
        `;
      }

      if (node.go) {
        detailsHtml += `
          <div class="pt-4 arch-drawer-divider">
            <button type="button" class="btn-primary w-full py-2.5 px-4 text-xs font-bold text-center inline-flex items-center justify-center gap-2 cursor-pointer" data-drilldown="${node.go}">
              <span>Check the Subsystem Architecture</span>
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
            </button>
          </div>
        `;
      }

      detailsHtml += `</div>`;
      drawerBody.innerHTML = detailsHtml;

      drawer.classList.add('is-open');
      drawer.classList.remove('pointer-events-none');
      drawer.setAttribute('aria-hidden', 'false');
      if (drawerBackdrop) {
        drawerBackdrop.classList.remove('opacity-0', 'pointer-events-none');
        drawerBackdrop.classList.add('opacity-100', 'pointer-events-auto');
      }
    }

    function closeDrawer() {
      if (!drawer) return;
      drawer.classList.remove('is-open');
      drawer.classList.add('pointer-events-none');
      drawer.setAttribute('aria-hidden', 'true');
      if (drawerBackdrop) {
        drawerBackdrop.classList.remove('opacity-100', 'pointer-events-auto');
        drawerBackdrop.classList.add('opacity-0', 'pointer-events-none');
      }
      setFocusNode(null);
    }

    // Bind Hover on initial SSR cards
    board.querySelectorAll('[data-node-id]').forEach(bindCardHover);

    // Canvas container hover reset
    if (canvasContainer) {
      canvasContainer.addEventListener('mouseleave', () => {
        setFocusNode(null);
      });
    }

    // Click Event Delegation with touch-scroll detection
    let touchMoved = false;
    let touchStartX = 0;
    let touchStartY = 0;

    board.addEventListener('touchstart', (e) => {
      touchMoved = false;
      if (e.touches && e.touches[0]) {
        touchStartX = e.touches[0].clientX;
        touchStartY = e.touches[0].clientY;
      }
    }, { passive: true });

    board.addEventListener('touchmove', (e) => {
      if (e.touches && e.touches[0]) {
        const dx = Math.abs(e.touches[0].clientX - touchStartX);
        const dy = Math.abs(e.touches[0].clientY - touchStartY);
        if (dx > 8 || dy > 8) {
          touchMoved = true;
        }
      }
    }, { passive: true });

    board.addEventListener('click', (e) => {
      if (touchMoved) {
        touchMoved = false;
        return;
      }
      const card = e.target.closest('[data-node-id]');
      if (!card) {
        setFocusNode(null);
        return;
      }

      const nodeId = card.dataset.nodeId;
      const view = arch.views[currentViewId];
      const node = view?.nodes.find(n => n.id === nodeId);
      if (!node) return;

      setFocusNode(nodeId);

      if (node.go) {
        renderView(node.go);
      } else {
        openNodeDrawer(node);
      }
    });

    drawerBody.addEventListener('click', (e) => {
      const drillBtn = e.target.closest('[data-drilldown]');
      if (drillBtn) {
        const targetView = drillBtn.dataset.drilldown;
        renderView(targetView);
      }
    });

    explorer.addEventListener('click', (e) => {
      const crumbBtn = e.target.closest('.arch-crumb-btn');
      if (crumbBtn) {
        renderView(crumbBtn.dataset.targetView || 'overview');
      }
    });

    if (btnBackOverview) {
      btnBackOverview.addEventListener('click', () => renderView('overview'));
    }
    if (btnBackOverviewBottom) {
      btnBackOverviewBottom.addEventListener('click', () => renderView('overview'));
    }

    drawerClose.addEventListener('click', closeDrawer);
    drawerBackdrop?.addEventListener('click', closeDrawer);
    drawerBackdrop?.addEventListener('touchmove', (e) => {
      e.preventDefault();
    }, { passive: false });

    document.addEventListener('pointerdown', (e) => {
      if (drawer && drawer.classList.contains('is-open')) {
        if (!drawer.contains(e.target) && !e.target.closest('[data-node-id]') && !e.target.closest('#arch-drawer-backdrop')) {
          closeDrawer();
        }
      }
    });

    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        if (drawer && drawer.classList.contains('is-open')) {
          closeDrawer();
        } else if (currentViewId !== 'overview') {
          renderView('overview');
        }
      }
    });

    window.addEventListener('resize', () => {
      requestAnimationFrame(drawWires);
    });

    // Theme change listener via MutationObserver
    const themeObserver = new MutationObserver(() => {
      requestAnimationFrame(drawWires);
    });
    themeObserver.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
    window.addEventListener('theme-change', () => {
      requestAnimationFrame(drawWires);
    });

    // Initial layout setup, min-width & draw on DOM ready and after fonts load
    updateCanvasMinWidth(arch.views[currentViewId]);
    requestAnimationFrame(drawWires);
    if (document.fonts) {
      document.fonts.ready.then(() => {
        requestAnimationFrame(drawWires);
      });
    }
  })();
</script>
