<script>
  function setupProofSync() {
    const tabButtons = document.querySelectorAll<HTMLButtonElement>('#proof-tabs .tab-btn');
    const codePanes = document.querySelectorAll<HTMLElement>('.proof-code-pane');
    const detailCards = document.querySelectorAll<HTMLElement>('.proof-card');
    const tabsContainer = document.getElementById('proof-tabs');

    function activateProofTab(button: HTMLButtonElement) {
      const targetKey = button.getAttribute('data-target');

      // 1. Update button active states with WAI-ARIA
      tabButtons.forEach(btn => {
        const isSelected = btn === button;
        btn.setAttribute('aria-selected', isSelected ? 'true' : 'false');
        btn.setAttribute('tabindex', isSelected ? '0' : '-1');
      });

      // Ensure active tab is smoothly centered on mobile viewports
      button.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });

      // 2. Synchronize code pane
      codePanes.forEach(pane => {
        if (pane.id === `code-pane-${targetKey}`) {
          pane.classList.remove('hidden');
          pane.classList.add('block');
        } else {
          pane.classList.remove('block');
          pane.classList.add('hidden');
        }
      });

      // 3. Synchronize feature detail card on the left
      detailCards.forEach(card => {
        if (card.id === `card-proof-${targetKey}`) {
          card.classList.remove('hidden');
          card.classList.add('block');
        } else {
          card.classList.remove('block');
          card.classList.add('hidden');
        }
      });
    }

    tabButtons.forEach(button => {
      button.addEventListener('click', () => {
        activateProofTab(button);
      });
    });

    if (tabsContainer && !tabsContainer.dataset.keyboardBound) {
      tabsContainer.dataset.keyboardBound = 'true';
      tabsContainer.addEventListener('keydown', (e: KeyboardEvent) => {
        const tabs = Array.from(tabButtons);
        const currentIndex = tabs.findIndex(tab => tab === document.activeElement);
        if (currentIndex === -1) return;

        let nextIndex = -1;
        if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
          e.preventDefault();
          nextIndex = (currentIndex + 1) % tabs.length;
        } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
          e.preventDefault();
          nextIndex = (currentIndex - 1 + tabs.length) % tabs.length;
        } else if (e.key === 'Home') {
          e.preventDefault();
          nextIndex = 0;
        } else if (e.key === 'End') {
          e.preventDefault();
          nextIndex = tabs.length - 1;
        }

        if (nextIndex !== -1) {
          tabs[nextIndex].focus();
          activateProofTab(tabs[nextIndex]);
        }
      });
    }

    const copyBtn = document.querySelector<HTMLButtonElement>('#why-it-exists .copy-code-btn');
    if (copyBtn && !copyBtn.dataset.listenerAttached) {
      copyBtn.dataset.listenerAttached = 'true';
      copyBtn.addEventListener('click', () => {
        const activePane = document.querySelector<HTMLElement>('#why-it-exists .proof-code-pane.block');
        const codeElement = activePane ? activePane.querySelector('code') || activePane : null;
        if (codeElement) {
          const text = codeElement.innerText || codeElement.textContent || '';
          navigator.clipboard.writeText(text.trim());
          const label = copyBtn.querySelector('.copy-label');
          if (label) {
            const originalText = label.textContent;
            label.textContent = 'Copied!';
            setTimeout(() => {
              label.textContent = originalText;
            }, 1500);
          }
        }
      });
    }
  }

  setupProofSync();
  document.addEventListener('astro:page-load', setupProofSync);
</script>
